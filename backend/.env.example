# ── Server ─────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Comma separated list of allowed browser origins, or *
CORS_ORIGIN=*
# Where the mobile/web client lives (used to build password-reset links)
APP_CLIENT_URL=http://localhost:19006

# ── Database (Supabase PostgreSQL) ─────────────────────
# Supabase Dashboard → Project Settings → Database → Connection string → URI
# Use the "Transaction" / pooler IPv4 URI for cloud hosted projects.
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Leave empty to auto-detect (SSL is enabled automatically for supabase.co hosts)
DB_SSL=

# ── Dev demo mode ──────────────────────────────────────
# Leave unset to auto-detect: with no usable DATABASE_URL the API runs on an
# in-memory store (demo account demo@campus.os / Campus123, data resets on
# restart). Set DEMO_MODE=true to force it, false to require real Postgres.
DEMO_MODE=

# ── Auth (Passport.js) ─────────────────────────────────
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ── Email (Nodemailer) ─────────────────────────────────
# Leave SMTP_HOST empty to run in "dev mode": emails are printed to the server
# console instead of being delivered. Works out of the box for local development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM="Campus OS <no-reply@campusos.app>"
# Inbox that receives the "Contact us" messages
CONTACT_EMAIL=support@campusos.app

# ── Uploads (Multer) ───────────────────────────────────
MAX_UPLOAD_MB=5
